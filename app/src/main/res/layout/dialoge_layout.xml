<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_150sdp"
    android:layout_margin="@dimen/_10sdp"
    android:background="@drawable/shape_dialoge"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_10sdp"
        android:src="@drawable/logout"></ImageView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_18sdp"
        android:gravity="center"
        android:text="Are you sure to Logout"></TextView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="match_parent"
            android:id="@+id/nobtn"
            android:background="@drawable/nobtn"
            android:layout_height="@dimen/_25sdp"
            android:textSize="@dimen/_16sdp"
            android:textColor="@color/black"
            android:layout_margin="@dimen/_10sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No"></TextView>

        <TextView
            android:layout_width="match_parent"
            android:id="@+id/yesbtn"
            android:layout_height="@dimen/_25sdp"
            android:background="@drawable/yesbtn"
            android:textSize="@dimen/_16sdp"
            android:textColor="@color/white"
            android:layout_margin="@dimen/_10sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Yes"></TextView>


    </LinearLayout>

</LinearLayout>